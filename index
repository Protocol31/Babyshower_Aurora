<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invitación Baby Shower - Aurora Elizabeth</title>
    
    <!-- Etiquetas para que el link se vea bonito en WhatsApp (Open Graph) -->
    <meta property="og:title" content="¡Estás invitado al Baby Shower de Aurora Elizabeth!" />
    <meta property="og:description" content="Nuestra bebé está en camino. ¡Haz clic para ver la invitación y confirmar tu asistencia!" />
    <!-- Idealmente aquí pondrías una URL de una imagen tuya, por ahora dejaré un placeholder bonito -->
    <meta property="og:image" content="https://placehold.co/1200x630/fbcfe8/ec4899?text=Baby+Shower+Aurora" />
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Montserrat:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            overflow: hidden; /* Prevent scrolling, acts like a video screen */
            background-color: #0a0a0a;
            font-family: 'Montserrat', sans-serif;
            color: white;
            touch-action: manipulation;
        }
        
        .font-script {
            font-family: 'Dancing Script', cursive;
        }

        /* Animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(3deg); }
        }
        @keyframes float-reverse {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(-3deg); }
        }
        @keyframes hover-ghost {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-8px) scale(1.02); }
        }
        @keyframes pulse-soft {
            0%, 100% { opacity: 0.8; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.05); }
        }

        .animate-float { animation: float 4s ease-in-out infinite; }
        .animate-float-reverse { animation: float-reverse 5s ease-in-out infinite; }
        .animate-ghost { animation: hover-ghost 3s ease-in-out infinite; }
        .animate-pulse-soft { animation: pulse-soft 2s ease-in-out infinite; }

        /* Reaction Animation */
        @keyframes pop-up {
            0% { transform: scale(0.5); opacity: 0; }
            30% { transform: scale(1.2); opacity: 1; }
            80% { transform: scale(1); opacity: 1; }
            100% { transform: scale(0.8); opacity: 0; }
        }
        .animate-pop-up { animation: pop-up 1.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }

        /* Scene Transitions */
        #scene-2 {
            opacity: 0;
            pointer-events: none;
            transform: scale(0.7) translateY(50px);
            transition: all 1s cubic-bezier(0.34, 1.56, 0.64, 1); /* Bouncy pop-in */
        }

        #scene-1 {
            transition: opacity 0.8s ease-in-out, transform 0.8s ease-in-out;
        }

        /* 3D Envelope Flap */
        #top-flap {
            transform-origin: 200px 50px;
            transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            transform-style: preserve-3d;
        }
        
        #envelope-card {
            transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .card-bg {
            background: radial-gradient(circle at center, #fff0f5 0%, #fce7f3 100%);
        }
    </style>
</head>
<body class="flex items-center justify-center h-[100dvh]">

    <!-- ================= SCENE 1: THE ENVELOPE ================= -->
