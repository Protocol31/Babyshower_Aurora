            </div>

            <!-- Details Section -->
            <div class="z-10 w-full flex flex-col items-center mt-2">
                <p class="font-bold tracking-[0.15em] text-[9px] md:text-[10px] text-gray-700 uppercase bg-white/60 px-3 py-1 rounded shadow-sm">
                    Únetenos a celebrar el baby shower de
                </p>
                
