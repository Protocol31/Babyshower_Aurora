    <script>
        // CONFIGURACIÓN DE WHATSAPP
        // 1. Pon tu número aquí (con el código de país). Para Chile es 569, ej: 56912345678
        const MI_NUMERO_WHATSAPP = "56955382562"; // <--- NÚMERO ACTUALIZADO

        function confirmarAsistencia(asistira) {
            const reactionContainer = document.getElementById('reaction-container');
            const reactionText = document.getElementById('reaction-text');
            
            // Reiniciar animación y mostrar fondo difuminado
            reactionContainer.classList.remove('opacity-0');
            reactionText.classList.remove('animate-pop-up');
            void reactionText.offsetWidth; // Truco técnico para que la animación se pueda repetir

            let mensaje = "";
            if(asistira) {
                reactionText.innerHTML = "<div class='text-7xl mb-2'>🥳</div><div class='font-black text-green-500 bg-white px-4 py-2 rounded-xl border-4 border-black text-xl uppercase tracking-wider shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]'>¡Genial!</div>";
                reactionText.classList.add('animate-pop-up');
                mensaje = "¡Hola! 🥳 Confirmo con mucha alegría mi asistencia al Baby Shower de la pequeña Aurora Elizabeth. ¡Nos vemos el Domingo 4!";
            } else {
                reactionText.innerHTML = "<div class='text-7xl mb-2'>🥺</div><div class='font-black text-gray-600 bg-white px-4 py-2 rounded-xl border-4 border-black text-lg uppercase tracking-wider shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]'>¡Te extrañaremos!</div>";
                reactionText.classList.add('animate-pop-up');
                mensaje = "¡Hola! 😢 Agradezco mucho la invitación al Baby Shower de Aurora. No podré ir, ¡pero te debo el regalito! Que lo pasen hermoso.";
            }
            
            // Esperar a que la animación termine (1.5 segundos) antes de abrir WhatsApp automáticamente
            setTimeout(() => {
                reactionContainer.classList.add('opacity-0');
                const urlWhatsApp = `https://wa.me/${56955382562}?text=${encodeURIComponent(mensaje)}`;
                window.open(urlWhatsApp, '_blank');
            }, 1500);
        }

        function openInvitation() {
            // 1. Animate the envelope flap opening
            const flap = document.getElementById('top-flap');
            flap.style.transform = 'rotateX(180deg)';
            
            // 2. Slightly move the card out of the envelope
            const innerCard = document.getElementById('envelope-card');
            setTimeout(() => {
                innerCard.style.transform = 'translateY(-40px)';
            }, 300);

            // 3. Zoom into the full Scene 2
            setTimeout(() => {
                const scene1 = document.getElementById('scene-1');
                const scene2 = document.getElementById('scene-2');
                
                // Fade and zoom out scene 1
                scene1.style.opacity = '0';
                scene1.style.transform = 'scale(1.2)';
                scene1.style.pointerEvents = 'none';

                // Pop in scene 2
                scene2.style.opacity = '1';
                scene2.style.transform = 'scale(1) translateY(0)';
                scene2.style.pointerEvents = 'auto';
            }, 800); // Wait for envelope animations to finish
        }
    </script>
